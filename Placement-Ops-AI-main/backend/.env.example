# Required for ES256/RS256 verification (Supabase's default "JWT Signing
# Keys" mode on new projects). The backend derives the JWKS endpoint from
# this: {SUPABASE_URL}/auth/v1/.well-known/jwks.json. The JWKS is public,
# so no secret is needed for this path.
SUPABASE_URL=https://fvnwqeumcxifqjqovemg.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZ2bndxZXVtY3hpZnFqcW92ZW1nIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODczNTkzODAsImV4cCI6MjEwMjkzNTM4MH0.tpyi3tlW_RUZTwQAqj8K7nfxD6weLrF_QUMR8hsML7c

# Only needed if your Supabase project is still on the legacy shared-secret
# (HS256) signing mode -- Project Settings -> API -> JWT Settings -> "Legacy
# JWT Secret". If your project uses the default asymmetric signing keys,
# this can be left unset; the JWKS path above handles verification instead.
SUPABASE_JWT_SECRET=44cb48dc-895a-4c3f-be4b-0672ac9370a0
